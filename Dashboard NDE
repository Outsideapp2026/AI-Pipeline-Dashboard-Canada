let filtered = [...RAW_DATA];
let currentPage = 1;
const PAGE_SIZE = 25;
let sortKey = 'name';
let sortDir = 1;

const REV_ORDER = ['$0 - $100K','$100K - $1M','$1M - $5M','$5M - $20M','$20M - $50M','$50M - $100M','$100M - $500M','$500M - $1B','$1B+'];
let charts = {};

// ── INIT ──────────────────────────────────────────────────────────────────
function init() {
  populateFilters();
  buildStats(RAW_DATA);
  buildCharts(RAW_DATA);
  applyFilters();
}

function populateFilters() {
  const s = [...new Set(RAW_DATA.map(r=>r.seniority).filter(Boolean))].sort();
  const c = [...new Set(RAW_DATA.map(r=>r.city).filter(Boolean))].sort();
  const rv = REV_ORDER.filter(r => RAW_DATA.some(c=>c.revenue===r));
  fill('filterSeniority', s);
  fill('filterCity', c);
  fill('filterRevenue', rv);
}

function fill(id, arr) {
  const sel = document.getElementById(id);
  arr.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; sel.appendChild(o); });
}

// ── STATS ─────────────────────────────────────────────────────────────────
function buildStats(data) {
  const total = data.length;
  const validEmails = data.filter(r=>r.emailValid==='valid').length;
  const clevel = data.filter(r=>r.seniority==='C-Level').length;
  const companies = new Set(data.map(r=>r.company).filter(Boolean)).size;
  const ndtOnly = data.filter(r=>r.tags && r.tags.includes('NDT')).length;
  const withPhone = data.filter(r=>r.phone).length;
  const withLI = data.filter(r=>r.linkedin).length;

  document.getElementById('statsGrid').innerHTML = [
    { label:'Total Contacts', val:total, sub:'Canada only', cls:'c-orange' },
    { label:'Companies', val:companies, sub:'unique orgs', cls:'c-blue' },
    { label:'NDT / NDE / Inspection', val:ndtOnly, sub:'inspection-focused', cls:'c-purple' },
    { label:'Valid Emails', val:validEmails, sub:`${Math.round(validEmails/total*100)}% deliverable`, cls:'c-green' },
    { label:'C-Level', val:clevel, sub:`${Math.round(clevel/total*100)}% of contacts`, cls:'c-yellow' },
    { label:'With Phone', val:withPhone, sub:'have phone numbers', cls:'c-orange' },
    { label:'LinkedIn', val:withLI, sub:'have LI profiles', cls:'c-blue' },
  ].map(s=>`<div class="stat-card"><div class="stat-label">${s.label}</div><div class="stat-value ${s.cls}">${s.val}</div><div class="stat-sub">${s.sub}</div></div>`).join('');
}

// ── CHARTS ────────────────────────────────────────────────────────────────
const COLORS = ['#f97316','#38bdf8','#a78bfa','#34d399','#fbbf24','#f87171','#818cf8','#2dd4bf','#fb923c'];

function counter(data, key) {
  const c = {};
  data.forEach(r => { const v=(r[key]||'Unknown'); c[v]=(c[v]||0)+1; });
  return c;
}
function topN(obj, n=8) {
  return Object.entries(obj).sort((a,b)=>b[1]-a[1]).slice(0,n);
}
function dc(id) { if(charts[id]) { charts[id].destroy(); delete charts[id]; } }

function buildCharts(data) {
  // Tags / Category
  dc('tags');
  const tagMap = { 'NDT/NDE/Inspection, Oil & Gas':'NDT + Oil & Gas', 'Oil & Gas':'Oil & Gas Only' };
  const tagCount = counter(data, 'tags');
  const tagLabels = Object.keys(tagCount).map(k=>tagMap[k]||k);
  charts['tags'] = new Chart(document.getElementById('chartTags'), {
    type:'doughnut',
    data:{ labels:tagLabels, datasets:[{ data:Object.values(tagCount), backgroundColor:['#38bdf8','#f97316','#a78bfa'], borderColor:'#1c1f2e', borderWidth:3 }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'right', labels:{ color:'#7b7f9a', font:{size:11}, boxWidth:12, padding:10 } } } }
  });

  // Seniority
  dc('seniority');
  const senE = topN(counter(data,'seniority'));
  charts['seniority'] = new Chart(document.getElementById('chartSeniority'), {
    type:'bar',
    data:{ labels:senE.map(e=>e[0]), datasets:[{ data:senE.map(e=>e[1]), backgroundColor:COLORS, borderRadius:6 }] },
    options:{ responsive:true, maintainAspectRatio:false, indexAxis:'y', plugins:{legend:{display:false}}, scales:{ x:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{color:'#272b3f'}}, y:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{display:false}} } }
  });

  // Revenue
  dc('revenue');
  const revD = REV_ORDER.filter(r=>data.some(c=>c.revenue===r)).map(r=>({ l:r, v:data.filter(c=>c.revenue===r).length }));
  charts['revenue'] = new Chart(document.getElementById('chartRevenue'), {
    type:'bar',
    data:{ labels:revD.map(e=>e.l), datasets:[{ data:revD.map(e=>e.v), backgroundColor:'#f97316', borderRadius:5 }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{ x:{ticks:{color:'#7b7f9a',font:{size:9},maxRotation:35},grid:{color:'#272b3f'}}, y:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{color:'#272b3f'}} } }
  });

  // Cities
  dc('cities');
  const cityE = topN(counter(data,'city'),10);
  charts['cities'] = new Chart(document.getElementById('chartCities'), {
    type:'bar',
    data:{ labels:cityE.map(e=>e[0]), datasets:[{ data:cityE.map(e=>e[1]), backgroundColor:'#38bdf8', borderRadius:6 }] },
    options:{ responsive:true, maintainAspectRatio:false, indexAxis:'y', plugins:{legend:{display:false}}, scales:{ x:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{color:'#272b3f'}}, y:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{display:false}} } }
  });

  // Staff
  dc('staff');
  const staffOrder=['1 - 10 employees','11 - 50 employees','51 - 200 employees','201 - 500 employees','501 - 1,000 employees','1,001 - 5,000 employees','5,001 - 10,000 employees','10,001+ employees'];
  const staffD=staffOrder.filter(s=>data.some(c=>c.staff===s)).map(s=>({ l:s, v:data.filter(c=>c.staff===s).length }));
  charts['staff'] = new Chart(document.getElementById('chartStaff'), {
    type:'bar',
    data:{ labels:staffD.map(e=>e.l), datasets:[{ data:staffD.map(e=>e.v), backgroundColor:'#a78bfa', borderRadius:6 }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{ x:{ticks:{color:'#7b7f9a',font:{size:9},maxRotation:35},grid:{color:'#272b3f'}}, y:{ticks:{color:'#7b7f9a',font:{size:11}},grid:{color:'#272b3f'}} } }
  });
}

// ── FILTERS ───────────────────────────────────────────────────────────────
function applyFilters() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const tag = document.getElementById('filterTag').value;
  const sen = document.getElementById('filterSeniority').value;
  const city = document.getElementById('filterCity').value;
  const rev = document.getElementById('filterRevenue').value;
  const em = document.getElementById('filterEmail').value;

  filtered = RAW_DATA.filter(r => {
    if(q && ![r.name,r.company,r.email,r.title,r.city].join(' ').toLowerCase().includes(q)) return false;
    if(tag && r.tags !== tag) return false;
    if(sen && r.seniority !== sen) return false;
    if(city && r.city !== city) return false;
    if(rev && r.revenue !== rev) return false;
    if(em && r.emailValid !== em) return false;
    return true;
  });

  document.getElementById('filterCount').textContent = filtered.length;
  currentPage = 1;
  sortData();
  renderTable();
  buildCharts(filtered);
}

function resetFilters() {
  document.getElementById('searchInput').value = '';
  ['filterTag','filterSeniority','filterCity','filterRevenue','filterEmail'].forEach(id => document.getElementById(id).value='');
  applyFilters();
}

// ── SORT ──────────────────────────────────────────────────────────────────
function sortTable(key) {
  if(sortKey===key) sortDir*=-1; else { sortKey=key; sortDir=1; }
  document.querySelectorAll('thead th').forEach(th=>th.classList.remove('sort-asc','sort-desc'));
  const cols=['name','title','company','tags','seniority','email','emailValid','city','revenue','linkedin'];
  const idx=cols.indexOf(key);
  if(idx>=0) document.querySelectorAll('thead th')[idx].classList.add(sortDir===1?'sort-asc':'sort-desc');
  sortData(); renderTable();
}

function sortData() {
  filtered.sort((a,b) => {
    let av=a[sortKey]||'', bv=b[sortKey]||'';
    if(sortKey==='revenue') return (REV_ORDER.indexOf(av)-REV_ORDER.indexOf(bv))*sortDir;
    return av.localeCompare(bv)*sortDir;
  });
}

// ── RENDER ────────────────────────────────────────────────────────────────
function tagBadge(t) {
  if(!t) return '';
  if(t.includes('NDT')&&t.includes('Oil')) return `<span class="badge b-both">NDT + Oil &amp; Gas</span>`;
  if(t.includes('NDT')) return `<span class="badge b-ndt">NDT/Inspection</span>`;
  return `<span class="badge b-og">Oil &amp; Gas</span>`;
}
function senBadge(s) {
  const m={'C-Level':'b-clevel','VP':'b-vp','Director':'b-director','Manager':'b-manager'};
  return `<span class="badge ${m[s]||'b-other'}">${s||'—'}</span>`;
}
function emailBadge(v) {
  if(v==='valid') return `<span class="badge b-valid">✓</span>`;
  if(v==='invalid') return `<span class="badge b-invalid">✗</span>`;
  if(v==='accept all') return `<span class="badge b-acceptall">~</span>`;
  return `<span style="color:var(--muted);font-size:11px">${v||'—'}</span>`;
}
function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderTable() {
  const start=(currentPage-1)*PAGE_SIZE;
  const page=filtered.slice(start,start+PAGE_SIZE);
  document.getElementById('tableBody').innerHTML = page.map((r,i)=>`
    <tr onclick="openModal(${start+i})">
      <td><div class="name-cell">${esc(r.name)||'—'}</div></td>
      <td style="color:var(--muted);font-size:12px;white-space:nowrap">${esc(r.title)||'—'}</td>
      <td>${r.website?`<a class="company-link" href="https://${esc(r.website)}" target="_blank" onclick="event.stopPropagation()">${esc(r.company)}</a>`:esc(r.company)||'—'}</td>
      <td>${tagBadge(r.tags)}</td>
      <td>${senBadge(r.seniority)}</td>
      <td>${r.email?`<a class="email-mono" href="mailto:${esc(r.email)}" onclick="event.stopPropagation()">${esc(r.email)}</a>`:'—'}</td>
      <td>${emailBadge(r.emailValid)}</td>
      <td style="white-space:nowrap">${esc(r.city)||'—'}</td>
      <td style="font-size:12px">${esc(r.revenue)||'—'}</td>
      <td>${r.linkedin?`<a class="li-link" href="${esc(r.linkedin)}" target="_blank" onclick="event.stopPropagation()">in</a>`:'—'}</td>
    </tr>
  `).join('');
  renderPagination();
}

function renderPagination() {
  const total=filtered.length, tp=Math.ceil(total/PAGE_SIZE);
  const s=(currentPage-1)*PAGE_SIZE+1, e=Math.min(currentPage*PAGE_SIZE,total);
  document.getElementById('pageInfo').textContent=`Showing ${s}–${e} of ${total}`;
  const btns=document.getElementById('pageBtns');
  let h=`<button class="page-btn" onclick="goPage(${currentPage-1})" ${currentPage===1?'disabled':''}>‹</button>`;
  pageRange(currentPage,tp).forEach(p=>{
    if(p==='...') h+=`<span style="padding:5px 4px;color:var(--muted)">…</span>`;
    else h+=`<button class="page-btn ${p===currentPage?'active':''}" onclick="goPage(${p})">${p}</button>`;
  });
  h+=`<button class="page-btn" onclick="goPage(${currentPage+1})" ${currentPage===tp?'disabled':''}>›</button>`;
  btns.innerHTML=h;
}

function pageRange(cur,tp) {
  if(tp<=7) return Array.from({length:tp},(_,i)=>i+1);
  if(cur<=4) return [1,2,3,4,5,'...',tp];
  if(cur>=tp-3) return [1,'...',tp-4,tp-3,tp-2,tp-1,tp];
  return [1,'...',cur-1,cur,cur+1,'...',tp];
}

function goPage(p) {
  const tp=Math.ceil(filtered.length/PAGE_SIZE);
  if(p<1||p>tp) return;
  currentPage=p;
  renderTable();
  document.querySelector('.table-card').scrollIntoView({behavior:'smooth',block:'start'});
}

