<div class="header">
  <div class="header-left">
    <div class="flag">🇨🇦</div>
    <div>
      <h1>Canada · NDT / NDE · Oil &amp; Gas · Inspection</h1>
      <div class="header-sub">Filtered from AI Pipeline export · March 2026</div>
    </div>
    <div class="header-pills" style="margin-left:8px">
      <span class="pill pill-canada">Canada Only</span>
      <span class="pill pill-ndt">NDT / NDE</span>
      <span class="pill pill-og">Oil &amp; Gas</span>
    </div>
  </div>
  <button class="export-btn" onclick="exportCSV()">⬇ Export CSV</button>
</div>

<div class="main">
  <div class="stats-grid" id="statsGrid"></div>

  <div class="charts-row">
    <div class="chart-card">
      <div class="chart-title">🏷 Contact Category</div>
      <div class="chart-wrap"><canvas id="chartTags"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">👤 Seniority</div>
      <div class="chart-wrap"><canvas id="chartSeniority"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">💰 Revenue Range</div>
      <div class="chart-wrap"><canvas id="chartRevenue"></canvas></div>
    </div>
  </div>
  <div class="charts-row-2">
    <div class="chart-card">
      <div class="chart-title">📍 Top Cities</div>
      <div class="chart-wrap-tall"><canvas id="chartCities"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">🏢 Staff Size</div>
      <div class="chart-wrap-tall"><canvas id="chartStaff"></canvas></div>
    </div>
  </div>

  <!-- FILTERS -->
  <div class="filters-bar">
    <div class="filters-top">
      <div class="filters-title">Filter &amp; Search</div>
      <span class="count-badge" id="filterCount">129</span>
    </div>
    <div class="filters-row">
      <input type="text" id="searchInput" placeholder="🔍  Name, company, email, title…" oninput="applyFilters()">
      <div class="filter-group">
        <span class="filter-label">Category</span>
        <select id="filterTag" onchange="applyFilters()">
          <option value="">All</option>
          <option value="NDT/NDE/Inspection, Oil &amp; Gas">NDT + Oil & Gas</option>
          <option value="Oil &amp; Gas">Oil & Gas Only</option>
        </select>
      </div>
      <div class="filter-group">
        <span class="filter-label">Seniority</span>
        <select id="filterSeniority" onchange="applyFilters()"><option value="">All</option></select>
      </div>
      <div class="filter-group">
        <span class="filter-label">City</span>
        <select id="filterCity" onchange="applyFilters()"><option value="">All</option></select>
      </div>
      <div class="filter-group">
        <span class="filter-label">Revenue</span>
        <select id="filterRevenue" onchange="applyFilters()"><option value="">All</option></select>
      </div>
      <div class="filter-group">
        <span class="filter-label">Email</span>
        <select id="filterEmail" onchange="applyFilters()">
          <option value="">All</option>
          <option value="valid">Valid Only</option>
          <option value="invalid">Invalid</option>
        </select>
      </div>
      <button class="reset-btn" onclick="resetFilters()">✕ Reset</button>
    </div>
  </div>

  <!-- TABLE -->
  <div class="table-card">
    <div class="table-header">
      <div class="table-header-title">Contacts</div>
      <div style="color:var(--muted);font-size:12px">Click any row for full details</div>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th onclick="sortTable('name')">Name <span></span></th>
            <th onclick="sortTable('title')">Title <span></span></th>
            <th onclick="sortTable('company')">Company <span></span></th>
            <th onclick="sortTable('tags')">Category <span></span></th>
            <th onclick="sortTable('seniority')">Level <span></span></th>
            <th onclick="sortTable('email')">Email <span></span></th>
            <th onclick="sortTable('emailValid')">Valid <span></span></th>
            <th onclick="sortTable('city')">City <span></span></th>
            <th onclick="sortTable('revenue')">Revenue <span></span></th>
            <th>LI</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>
    <div class="pagination">
      <div class="page-info" id="pageInfo"></div>
      <div class="page-btns" id="pageBtns"></div>
    </div>
  </div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal(event)">
  <div class="modal" id="modalContent">
    <button class="modal-close" onclick="closeModalBtn()">✕</button>
    <div id="modalBody"></div>
  </div>
</div>

