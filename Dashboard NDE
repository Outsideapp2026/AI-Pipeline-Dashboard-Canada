<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Canada · NDT / Oil & Gas Contacts</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root {
    --bg: #0c0f18;
    --surface: #141720;
    --card: #1c1f2e;
    --border: #272b3f;
    --accent: #f97316;
    --accent2: #38bdf8;
    --accent3: #a78bfa;
    --green: #34d399;
    --red: #f87171;
    --yellow: #fbbf24;
    --text: #e8eaf0;
    --muted: #7b7f9a;
    --tag-ndt: #a78bfa;
    --tag-oilgas: #f97316;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; }

  /* HEADER */
  .header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 14px 28px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
  .header-left { display: flex; align-items: center; gap: 14px; }
  .flag { font-size: 24px; line-height: 1; }
  .header h1 { font-size: 17px; font-weight: 700; }
  .header-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .header-pills { display: flex; gap: 6px; }
  .pill { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
  .pill-canada { background: rgba(248,113,19,.15); color: var(--accent); border: 1px solid rgba(248,113,19,.3); }
  .pill-ndt { background: rgba(167,139,250,.15); color: var(--accent3); border: 1px solid rgba(167,139,250,.3); }
  .pill-og { background: rgba(56,189,248,.15); color: var(--accent2); border: 1px solid rgba(56,189,248,.3); }
  .export-btn { background: var(--accent); color: white; border: none; padding: 8px 16px; border-radius: 7px; cursor: pointer; font-size: 13px; font-weight: 600; transition: opacity .2s; white-space: nowrap; }
  .export-btn:hover { opacity: .85; }

  /* MAIN */
  .main { padding: 22px 28px; max-width: 1600px; margin: 0 auto; }

  /* STATS */
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 22px; }
  .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; }
  .stat-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 7px; }
  .stat-value { font-size: 26px; font-weight: 700; line-height: 1; }
  .stat-sub { font-size: 11px; color: var(--muted); margin-top: 5px; }
  .c-orange { color: var(--accent); }
  .c-blue { color: var(--accent2); }
  .c-purple { color: var(--accent3); }
  .c-green { color: var(--green); }
  .c-yellow { color: var(--yellow); }

  /* CHARTS */
  .charts-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 12px; margin-bottom: 22px; }
  .charts-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 22px; }
  .chart-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; }
  .chart-title { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; }
  .chart-wrap { position: relative; height: 200px; }
  .chart-wrap-tall { position: relative; height: 250px; }

  /* FILTERS */
  .filters-bar { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; margin-bottom: 18px; }
  .filters-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .filters-title { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; font-weight: 600; }
  .filters-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  select, input[type=text] { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 6px 10px; border-radius: 6px; font-size: 13px; outline: none; transition: border-color .2s; }
  select:focus, input[type=text]:focus { border-color: var(--accent); }
  input[type=text] { width: 260px; }
  .filter-group { display: flex; align-items: center; gap: 5px; }
  .filter-label { font-size: 11px; color: var(--muted); white-space: nowrap; }
  .reset-btn { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 6px 13px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all .15s; }
  .reset-btn:hover { border-color: var(--accent); color: var(--text); }
  .count-badge { background: var(--accent); color: white; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; }

  /* TABLE */
  .table-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .table-header { padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
  .table-header-title { font-weight: 600; font-size: 15px; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 1000px; }
  thead th { background: var(--surface); color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .5px; padding: 9px 13px; text-align: left; border-bottom: 1px solid var(--border); cursor: pointer; white-space: nowrap; user-select: none; }
  thead th:hover { color: var(--text); }
  thead th.sort-asc span::after { content: " ▲"; color: var(--accent); }
  thead th.sort-desc span::after { content: " ▼"; color: var(--accent); }
  tbody tr { border-bottom: 1px solid rgba(39,43,63,.7); transition: background .1s; cursor: pointer; }
  tbody tr:hover { background: rgba(249,115,22,.05); }
  tbody tr:last-child { border-bottom: none; }
  td { padding: 10px 13px; vertical-align: middle; }
  .name-cell { font-weight: 600; white-space: nowrap; }
  .company-link { color: var(--accent2); text-decoration: none; font-weight: 500; }
  .company-link:hover { text-decoration: underline; }
  .email-mono { font-family: monospace; font-size: 12px; color: var(--text); text-decoration: none; }
  .email-mono:hover { color: var(--accent2); }

  /* BADGES */
  .badge { display: inline-block; padding: 2px 7px; border-radius: 20px; font-size: 10px; font-weight: 700; white-space: nowrap; }
  .b-clevel { background: rgba(249,115,22,.18); color: var(--accent); }
  .b-vp { background: rgba(56,189,248,.18); color: var(--accent2); }
  .b-director { background: rgba(167,139,250,.18); color: var(--accent3); }
  .b-manager { background: rgba(251,191,36,.18); color: var(--yellow); }
  .b-other { background: rgba(123,127,154,.15); color: var(--muted); }
  .b-valid { background: rgba(52,211,153,.15); color: var(--green); }
  .b-invalid { background: rgba(248,113,113,.15); color: var(--red); }
  .b-acceptall { background: rgba(251,191,36,.15); color: var(--yellow); }
  .b-ndt { background: rgba(167,139,250,.15); color: var(--accent3); border: 1px solid rgba(167,139,250,.25); }
  .b-og { background: rgba(249,115,22,.12); color: var(--accent); border: 1px solid rgba(249,115,22,.2); }
  .b-both { background: rgba(56,189,248,.12); color: var(--accent2); border: 1px solid rgba(56,189,248,.2); }
  .li-link { color: var(--accent2); text-decoration: none; font-weight: 700; font-size: 12px; }
  .li-link:hover { color: var(--accent3); }

  /* PAGINATION */
  .pagination { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; border-top: 1px solid var(--border); }
  .page-info { color: var(--muted); font-size: 12px; }
  .page-btns { display: flex; gap: 5px; }
  .page-btn { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 5px 11px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all .15s; }
  .page-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .page-btn.active { background: var(--accent); border-color: var(--accent); color: white; }
  .page-btn:disabled { opacity: .35; cursor: not-allowed; }

  /* MODAL */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.75); z-index: 200; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--card); border: 1px solid var(--border); border-radius: 16px; width: 92%; max-width: 700px; max-height: 88vh; overflow-y: auto; padding: 26px; position: relative; }
  .modal-close { position: absolute; top: 14px; right: 16px; background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; }
  .modal-close:hover { color: var(--text); }
  .modal-avatar { width: 48px; height: 48px; border-radius: 12px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; color: white; flex-shrink: 0; }
  .modal-top { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 20px; }
  .modal-name { font-size: 20px; font-weight: 700; line-height: 1.2; }
  .modal-subtitle { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .modal-tags { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .modal-section { margin-bottom: 16px; }
  .modal-section-title { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; font-weight: 600; }
  .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mf { background: var(--surface); border-radius: 8px; padding: 9px 13px; }
  .mf-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .4px; margin-bottom: 3px; }
  .mf-value { font-size: 13px; word-break: break-word; }
  .mf-value a { color: var(--accent2); text-decoration: none; }
  .mf-value a:hover { text-decoration: underline; }
  .modal-desc { background: var(--surface); border-radius: 8px; padding: 11px 14px; font-size: 12px; color: var(--muted); line-height: 1.6; margin-bottom: 16px; }
  .modal-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .modal-btn { padding: 8px 16px; border-radius: 7px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-block; transition: opacity .15s; }
  .modal-btn:hover { opacity: .85; }
  .mb-primary { background: var(--accent); color: white; }
  .mb-sec { background: var(--surface); color: var(--text); border: 1px solid var(--border); }

  @media (max-width:860px) {
    .charts-row { grid-template-columns: 1fr; }
    .charts-row-2 { grid-template-columns: 1fr; }
    .modal-grid { grid-template-columns: 1fr; }
    .main { padding: 14px; }
    .header { padding: 12px 14px; flex-wrap: wrap; gap: 10px; }
    input[type=text] { width: 200px; }
  }
</style>
</head>
