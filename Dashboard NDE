        <div class="mf"><div class="mf-label">Founded</div><div class="mf-value">${esc(r.founded)||'—'}</div></div>
        <div class="mf"><div class="mf-label">Website</div><div class="mf-value">${r.website?`<a href="https://${esc(r.website)}" target="_blank">${esc(r.website)}</a>`:'—'}</div></div>
      </div>
    </div>

    ${r.companyDesc?`<div class="modal-section"><div class="modal-section-title">About</div><div class="modal-desc">${esc(r.companyDesc)}${r.companyDesc.length>=300?'…':''}</div></div>`:''}

    ${r.timeInRole||r.timeAtCompany?`
    <div class="modal-section">
      <div class="modal-section-title">Tenure</div>
      <div class="modal-grid">
        ${r.timeInRole?`<div class="mf"><div class="mf-label">Time in Role</div><div class="mf-value">${esc(r.timeInRole)}</div></div>`:''}
        ${r.timeAtCompany?`<div class="mf"><div class="mf-label">Time at Company</div><div class="mf-value">${esc(r.timeAtCompany)}</div></div>`:''}
      </div>
    </div>`:''}

    <div class="modal-actions">
      ${r.email?`<a class="modal-btn mb-primary" href="mailto:${esc(r.email)}">✉ Email</a>`:''}
      ${r.linkedin?`<a class="modal-btn mb-sec" href="${esc(r.linkedin)}" target="_blank">in LinkedIn</a>`:''}
